{
  "$schema": "https://raw.githubusercontent.com/nicovrc/tauri-config-schema/main/schema.json",
  "productName": "bubble-nav",
  "version": "0.1.0",
  "identifier": "com.bubble-nav.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bubble-nav",
        "width": 1200,
        "height": 900,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
