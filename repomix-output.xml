  is_dir: boolean;
}

export interface HistoryState {
  path: string;
  x: number;
  y: number;
}

export interface RenderNode {
  label: string;
  isDir: boolean;
  isAction: boolean;
  isBack: boolean;
  actionId?: string;
  path?: string;
  worldX: number;
  worldY: number;
  radius: number;
  baseColor: string;
}

export interface AnimatedNode extends RenderNode {
  curX: number;
  curY: number;
  curRadius: number;
  curAlpha: number;
  key: string;
}
