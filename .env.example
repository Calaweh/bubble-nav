# Copy this file to .env and customize for your machine

# Default WSL distro name
WSL_DISTRO=Ubuntu

# Editor binary paths (command name on PATH, or full path)
VSCODE_BIN=C:\Users\User\AppData\Local\Programs\Microsoft VS Code\Code.exe
ANTIGRAVITY_PATH=C:\Users\User\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Antigravity IDE\Antigravity.exe
VISUALSTUDIO_PATH=C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\devenv.exe

# OpenCode binary path inside WSL distro (shell variable $HOME is expanded by the shell)
OPENCODE_BIN=$HOME/.opencode/bin/opencode

# Starting directory when app launches
VITE_START_PATH=C:\Projects
